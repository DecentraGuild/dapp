# GitHub Pages Headers
# Note: GitHub Pages has limited header support
# Only basic caching headers work, no custom MIME types or gzip

# Cache static assets for 1 hour
/SLP/*
  Cache-Control: public, max-age=3600

# Cache built assets for longer (they have content hashes)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Don't cache HTML
/*.html
  Cache-Control: no-cache
